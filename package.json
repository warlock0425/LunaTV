{
  "name": "berserkertv",
  "version": "2.5.4",
  "private": true,
  "scripts": {
    "dev": "pnpm gen:manifest && next dev -H 0.0.0.0",
    "build": "pnpm gen:manifest && next build",
    "start": "next start",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix && pnpm format",
    "lint:strict": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit --incremental false",
    "test:watch": "jest --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:install": "playwright install chromium",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "gen:manifest": "node scripts/generate-manifest.js",
    "postbuild": "echo 'Build completed - sitemap generation disabled'",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-virtual": "^3.13.19",
    "@upstash/redis": "^1.25.0",
    "artplayer": "^5.4.0",
    "bs58": "^6.0.0",
    "crypto-js": "^4.2.0",
    "he": "^1.2.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.438.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "opencc-js": "1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "redis": "^4.6.7",
    "switch-chinese": "1.0.16",
    "undici": "^7.28.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.61.1",
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/forms": "^0.5.10",
    "@testing-library/jest-dom": "^6.9.1",
    "@types/crypto-js": "^4.2.2",
    "@types/he": "^1.2.3",
    "@types/jest": "^29.5.14",
    "@types/node": "24.0.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "autoprefixer": "^10.4.20",
    "babel-loader": "9.2.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.18",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^17.0.8",
    "next-router-mock": "^0.9.0",
    "postcss": "^8.5.1",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx}": [
      "node scripts/check-simplified.js",
      "eslint --max-warnings=0",
      "prettier -w"
    ],
    "**/*.{json,css,scss,md,webmanifest}": [
      "prettier -w"
    ]
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=18.17.0",
    "pnpm": ">=8"
  },
  "pnpm": {
    "overrides": {
      "form-data": ">=3.0.4",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.7": ">=5.1.7",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "postcss@<8.5.10": ">=8.5.10",
      "picomatch@<2.3.2": ">=2.3.2",
      "fast-uri@<=3.1.0": ">=3.1.1",
      "serialize-javascript@>=5.0.0 <7.0.5": ">=7.0.5",
      "semver@>=7.0.0 <7.5.2": ">=7.5.2",
      "glob@>=10.2.0 <10.5.0": ">=10.5.0",
      "@babel/core@<=7.29.0": ">=7.29.6"
    }
  }
}
